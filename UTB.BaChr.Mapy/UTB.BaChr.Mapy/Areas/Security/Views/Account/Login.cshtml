@model UTB.BaChr.Mapy.Application.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Přihlášení - Firewatch Net";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white border-warning">
                <div class="card-header bg-warning text-dark">
                    <h3>Vstup do systému</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Uživatelské jméno</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Heslo</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Pamatovat si mě</label>
                        </div>

                        <button type="submit" class="btn btn-warning w-100">Přihlásit se</button>
                    </form>
                </div>
                <div class="card-footer text-muted">
                    <a asp-action="Register" class="text-warning">Nemáte účet? Zaregistrujte se.</a>
                </div>
            </div>
        </div>
    </div>
</div>