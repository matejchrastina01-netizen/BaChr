@using UTB.BaChr.Mapy.Domain.Entities
@model IList<Location>

@{
    ViewData["Title"] = "Mapa Lokací";
}

<div class="text-center py-5 bg-dark text-warning" style="border-bottom: 5px solid #ffc107;">
    <h1 class="display-4 fw-bold">FIREWATCH EXPLORER</h1>
    <p class="lead text-white">Prozkoumej divočinu Wyomingu a najdi skrytá tajemství.</p>
</div>

<div class="container mt-5">
    <div class="row">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 bg-secondary text-white border-0 shadow-lg">

                        <div class="card-img-top bg-dark d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-warning display-6">@item.Name[0]</span>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title text-warning">@item.Name</h5>
                            <p class="card-text text-light">@item.Description</p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <small class="text-warning">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    Lat: @item.Latitude, Lon: @item.Longitude
                                </small>
                            </div>
                        </div>
                        <div class="card-footer bg-dark border-top border-warning">
                            <a href="#" class="btn btn-outline-warning w-100">Zobrazit detaily</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <div class="alert alert-warning">
                    Zatím nebyly objeveny žádné lokace. (Databáze je prázdná)
                </div>
            </div>
        }
    </div>
</div>